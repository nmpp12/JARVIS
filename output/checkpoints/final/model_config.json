{
  "vocab_size": 32000,
  "hidden_dim": 256,
  "num_layers": 6,
  "num_heads": 8,
  "num_kv_heads": 2,
  "intermediate_dim": 704,
  "max_seq_len": 512,
  "dropout": 0.0,
  "attention_dropout": 0.0,
  "embed_dropout": 0.0,
  "rope_theta": 10000.0,
  "rms_norm_eps": 1e-06,
  "tie_word_embeddings": true,
  "use_flash_attention": true,
  "use_bitnet": true,
  "bitnet_exclude": "token_embedding,lm_head",
  "use_sliding_window": false,
  "sliding_window_size": 512,
  "use_early_exit": false,
  "early_exit_confidence": 0.9,
  "early_exit_min_layer": 2,
  "use_token_pruning": false,
  "token_pruning_threshold": 0.5,
  "kv_cache_quantize_bits": null,
  "use_paged_kv_cache": false,
  "paged_kv_page_size": 16,
  "use_triton_kernels": true,
  "initializer_range": 0.02,
  "gradient_checkpointing": false,
  "model_type": "mom"
}